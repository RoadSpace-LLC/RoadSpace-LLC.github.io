---
import activity from '../data/activity.json';
const now = activity.updatedAt ? new Date(activity.updatedAt) : new Date();
const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
const first = new Date(today);
first.setUTCDate(first.getUTCDate() - 364);
const gridStart = new Date(first);
gridStart.setUTCDate(gridStart.getUTCDate() - gridStart.getUTCDay());
const days = [];
for (let d = new Date(gridStart); d <= today; d.setUTCDate(d.getUTCDate() + 1)) {
  const date = d.toISOString().slice(0, 10);
  const count = (activity.counts as Record<string, number>)[date] || 0;
  days.push({ date, count, outside: d < first, level: count === 0 ? 0 : count < 3 ? 1 : count < 6 ? 2 : count < 10 ? 3 : 4 });
}
const total = Object.values(activity.counts).reduce((sum, count) => sum + count, 0);
---
<section class="activity" aria-labelledby="activity-title">
  <div class="activity-heading">
    <span>
        {activity.available
        ? `${total.toLocaleString('en-US')} commits in the past year`
        : 'Activity data is not connected.'}
    </span>
</div>
    <div class="heatmap-scroll" tabindex="0" role="region" aria-label="Daily commit counts. Scroll horizontally to view the full year.">
      <div class="heatmap" role="list">
        {days.map(day => <span role="listitem" class:list={['day', `level-${day.level}`, { outside: day.outside }]} title={`${day.date}: ${day.count} commits`} aria-label={`${day.date}: ${day.count} commits`} />)}
      </div>
    </div>
</section>
<style>
  .activity {
    flex-shrink: 0;
    min-width: 0;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #45433f;
    }
  .activity-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  h2 { margin: 0; font-size: 1.7rem; font-weight: normal; }
  .activity-heading span, .activity-caption, .activity-updated, .activity-empty { color: var(--muted); font-size: 1.2rem; }
  .heatmap-scroll { overflow-x: auto; padding: 3px; scrollbar-width: thin; }
  .heatmap-scroll:focus-visible { outline: 2px solid var(--link); }
  .heatmap { display: grid; grid-template-rows: repeat(7, 8px); grid-auto-columns: 8px; grid-auto-flow: column; gap: 3px; width: max-content; }
  .day { display: block; width: 8px; height: 8px; border-radius: 1px; background: #292b29; border: 1px solid #ffffff0d; }
  .level-1 { background: #254b32; } .level-2 { background: #397749; } .level-3 { background: #64a969; } .level-4 { background: #a1d690; }
  .outside { visibility: hidden; }
  .activity-caption { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.8rem; }
  .legend { display: flex; align-items: center; gap: 4px; }
  .activity-updated { margin: 0.5rem 0 0; }
  .activity-empty { margin: 0; }
</style>
