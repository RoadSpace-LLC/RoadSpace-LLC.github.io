---
import Article from '../components/Article.astro';
const home = import.meta.env.BASE_URL;
---

<Article title="">
  <div class="signup-page">
    <div class="form-region">
      <div class="ml-embedded" data-form="2IXTQ7"></div>
    </div>
    <p class="back-link">
      <a href={home}>&larr; Back to main page</a>
    </p>
  </div>
</Article>

<style>
  .signup-page {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    min-width: 0;
  }

  .form-region {
    display: flex;
    flex: 1 0 auto;
    align-items: center;
    justify-content: center;
  }

  .ml-embedded {
    width: 100%;
    max-width: 400px;
    min-width: 0;
  }

  /* MailerLite injects these elements, so they need global selectors. */
  .form-region :global(.ml-form-embedContainer) {
    display: block !important;
    height: auto !important;
    width: 100% !important;
  }

  .form-region :global(.ml-form-embedContainer > div) {
    display: block !important;
    height: auto !important;
    width: 100% !important;
  }

  .form-region :global(.ml-form-embedWrapper) {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  .back-link {
    flex-shrink: 0;
    margin: 2rem 0 0;
  }
</style>
